"""
Represents a registered account on the platform. Users have a public profile, can author posts, and participate in the follow graph
"""
type User {
    """
    Unique UUID identifier that identifies this user.
    """
    id: ID!
    """
    Display name shown on the user's profile.

    Size must be maximum of 50 characters.
    """
    displayName: String!
    """
    Unique username used to identify the account.

    Size must be minimum of 4 and a maximum of 15 characters.
    handle must contain alphanumeric and underscores only, cannot be purely numeric.
    """
    handle: String!
    """
    Short user biography.

    Size must be a maximum of 160 characters.
    """
    bio: String
    """
    Profile image URL.
    """
    profileImage: String
    """
    Datetime of account creation.
    """
    createdAt: DateTime
    """
    Datetime of last account update.
    """
    updatedAt: DateTime
    """
    Paginated list of posts authored by this user profile.
    """
    posts(first: Int = 10, after: String): PostConnection!
    """
    Paginated list of users which follow this user profile.

    Sorted descendingly by follower creation date.
    """
    followers(first: Int = 10, after: String): UserConnection!
    """
    Total number of account which follow this user.
    """
    followerCount: Long!
    """
    Paginated list of users which this user profile follows.

    Sorted descendingly by following creation date.
    """
    following(first: Int = 10, after: String): UserConnection!
    """
    Total number of accounts this user is following.
    """
    followingCount: Long!
    """
    {@code true} if the authenticated user follows the user.
    """
    isFollowing: Boolean!
}
# Following yourself should fail
# Double follow -> # Idempotent: returns success, no duplicate created
# Look to claude chat for edge cases!

"""
Represents the status of a user's account
"""
enum UserStatus {
    ACTIVE
    SUSPENDED
    DELETED
}

extend type Query {
    """
    Fetch authenticated user.

    Authentication: Required (user can only fetch their own profile with me)
    """
    me: User!
    """
    Fetch user with queried handle.

    Authentication: Required
    """
    userByHandle(handle: String!): User
    """
    Fetch user with queried ID.

    Authentication: Required
    """
    userById(id: ID!): User
    """
    Fetch users whose handles contain the given query string.

    Authentication: Required
    """
    searchUsers(query: String!, first: Int = 10, after: String): UserConnection!
    """
    Fetch user accounts which the authenticated user does not follow.

    Authentication: Required
    """
    suggestedUsers(first: Int = 10, after: String): UserConnection!
}

# create User in authorisation type
extend type Mutation {
    # TODO - Admin can update any user by using adminUpdateUser mutation.
    """
    Update user profile information.

    Authentication: Required (user can only update their own profile)
    """
    updateMyProfile(input: UpdateUserInput!): UserResponse!
    # Cannot be undone (for MVP - could add restore later)
    """
    Delete the authenticated user's account.
    Soft delete - sets the account status to DELETED and soft deletes all authored posts.

    Authentication: Required
    """
    deleteMyAccount: DeleteResponse!
    """
    Create follow between authenticated user profile (following) and queried id (follower).

    Authentication: Required
    """
    followUser(userIdToFollow: ID!): UserResponse!
    """
    Delete follow between authenticated user profile (following) and queried id (follower).

    Authentication: Required
    """
    unfollowUser(userIdToUnfollow: ID!): UserResponse!
}

"""At least one field must be provided"""
input UpdateUserInput {
    displayName: String,
    handle: String,
    bio: String,
    profileImage: String
}

"""
Result of a mutating operation on a user.
"""
type UserResponse implements MutationResponse {
    code: String!
    success: Boolean!
    user: User
    errors: [Error!]
}

