"""
Represents a post on the platform. Posts can contain text or can share other posts (reposts). Posts can also contain mentions and comments.
"""
type Post {
    """
    Unique UUID identifier.
    """
    id: ID!
    """
    The user which created the post.
    """
    author: User!
    # TODO - update schema when media introduced
    """
    Text content of a post.

    Optional as the text content is null for pure reposts.

    Size has a maximum length of 280 characters.
    """
    messageContent: String

    # Core fields
    """
    Datetime of post creation.
    """
    createdAt: DateTime!
    """
    Datetime of last post update.
    """
    updatedAt: DateTime!

    # Likes functionality
    likeCount: Int!
    likedByMe: Boolean!
    likes(first: Int, after: String): UserConnection! # Who liked this

    # Comments functionality
    parent: Post
    comments(first: Int, after: String): PostConnection!
    commentCount: Int!

    # Repost functionality
    # Idea here was to separate between when somebody reposts with a comment (quote) vs a simple repost
    # REPOST MODEL:
    # - Pure repost: Creates Post with messageContent=null, quotedPost=originalPost
    # - Quote: Creates Post with messageContent + quotedPost=originalPost
    # - repostedBy returns Users who created either type
    repostCount: Int! # Pure reposts + quotes combined
    repostedByMe: Boolean!
    quotedPost: Post
    repostedBy(first: Int, after: String): UserConnection!
    quotes(first: Int, after: String): PostConnection!

    mentions: [User!] # Users tagged in post
}
# In a later iteration I will add media content

extend type Query {
    # TODO - searchPosts
    """
    Fetch post with queried id.

    Returns null for a not-found post.
    """
    getPost(postId: ID!): Post
    # TODO: Update schema comment when feed algorithm is improved
    """
    Fetch posts from followed accounts. Posts from the authenticated user are not in their own feed.

    Authentication: Required.
    """
    feed(first: Int = 10, after: String): PostConnection!
}

extend type Mutation {
    """
    Create a post.

    Authentication: Required.
    """
    createPost(input: CreatePostInput!): PostResponse!
    createComment(input: CreateCommentInput!): PostResponse!
    createRepost(input: CreateRepostInput!): PostResponse!
    createQuote(input: CreateQuoteInput!): PostResponse!
    """
    Update post content.

    Applies to posts, comments, and quotes.

    Authentication: Required (user can update their own posts)
    """
    updatePostContent(input: UpdatePostInput!): PostResponse!
    """
    Delete the post.
    Soft delete - sets the post status to DELETED.

    Applies to all post types.

    Authentication: Required (the authenticated user can delete their own posts)
    """
    deletePost(postId: ID!): DeleteResponse!

    # Likes
    likePost(input: UpdatePostLikesInput): PostResponse!
    unlikePost(input: UpdatePostLikesInput): PostResponse!
}

"""
Information required to create a post.
"""
input CreatePostInput {
    messageContent: String!
    mentionedUserIds: [ID!]
}

"""
Information required to update a post.
"""
input UpdatePostInput {
    id: ID!
    messageContent: String!
    mentionedUserIds: [ID!]
}

input UpdatePostLikesInput {
    id: ID!
}

input CreateCommentInput {
    parentId: ID!
    messageContent: String!
    mentionedUserIds: [ID!]
}

input CreateRepostInput {
    postId: ID!
}

input CreateQuoteInput {
    quotedPostId: ID!
    messageContent: String!
    mentionedUserIds: [ID!]
}

"""
Result of a mutating operation on a post.
"""
type PostResponse implements MutationResponse {
    code: String!
    success: Boolean!
    post: Post
    errors: [Error!]
}

# Subscription for:
# C/U/D post
# Likes/unlikes
# C/U/D Comment
# C/U/D Repost

extend type Subscription {
    postEngagement(postId: ID!): EngagementEvent!
    # Real-time feed updates for the authenticated user
    # Emits when someone you follow creates a post
    # Backed by Redis Pub/Sub feed queue
    newPostInFeed: Post!
}

# Can I do a live notification with subscription or 
# do I need separate implementation with Websockets?
# Note: GraphQL subscriptions use WebSockets (Spring Boot GraphQL handles this automatically)
