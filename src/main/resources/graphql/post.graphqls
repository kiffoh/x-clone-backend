"""
Represents a post on the platform. Posts can contain text or can share other posts (reposts). Posts can also contain mentions and comments.
"""
type Post {
    """
    Unique UUID identifier that identifies this post.
    """
    id: ID!
    """
    The user which created the post.
    """
    author: User!
    # TODO - update schema when media introduced
    """
    Text content of this post.

    Optional as the text content is null for pure reposts.

    Size has a maximum length of 280 characters.
    """
    messageContent: String
    """
    Datetime of post creation.
    """
    createdAt: DateTime!
    """
    Datetime of last post update.
    """
    updatedAt: DateTime!
    # Likes functionality
    """
    Amount of likes that this post has.
    """
    likeCount: Int!
    """
    {@code true} if the authenticated user likes this post.
    """
    likedByMe: Boolean!
    """
    Paginated list of users which like this post.
    """
    likes(first: Int = 5, after: String): UserConnection!

    # Reply functionality
    """
    Parent post that this post replied to.

    Null for posts with no parent (e.g. original posts in a reply chain).
    """
    parent: Post
    """
    Amount of replies that this post has.
    """
    replyCount: Int!
    """
    Paginated list of posts which directly replied to this post.
    """
    replies(first: Int = 10, after: String): PostConnection!
    # Repost functionality
    """
    Unique UUID identifier of the shared post.

    Null for posts which are not shares.

    If sharedPostId is non-null and sharedPost is null; the shared post has been deleted.
    """
    sharedPostId: ID
    """
    Post that this post shared.

    Null for posts which are not shares (e.g. original posts in a post chain).
    """
    sharedPost: Post
    """
    Paginated list of posts which directly quoted to this post.

    A quote is a share with message content.

    Sorted descendingly by quote creation date.
    """
    quotes(first: Int = 10, after: String): PostConnection!
    """
    Paginated list of users which reposted this post.

    A repost is a share with no message content.

    Users sorted descendingly by repost creation date.
    """
    reposts(first: Int = 10, after: String): UserConnection!
    """
    Amount of shares that this post has.

    A share includes either a repost or a quote. Each quote and repost from a user is counted separately.
    """
    shareCount: Int!
    """
    {@code true} if the authenticated user has actively shared this post.

    A share includes either a repost or a quote. Therefore {@code sharedByMe=true} for at least one active repost or quote.
    """
    sharedByMe: Boolean!

    mentions: [User!] # Users tagged in post
}
# In a later iteration I will add media content

extend type Query {
    # TODO - searchPosts
    """
    Fetch post with queried id.

    Returns null for a not-found post.

    Authentication: Required.
    """
    getPost(postId: ID!): Post
    # TODO: Update schema comment when feed algorithm is improved
    """
    Fetch posts from followed accounts. Posts from the authenticated user are not in their own feed.

    Authentication: Required.
    """
    feed(first: Int = 10, after: String): PostConnection!
    """
    Fetch all posts in the queried reply thread.

    ReplyThread is nullable for request sent with an invalid postId.

    Authentication: Required.
    """
    getReplyThread(postId: ID!): ReplyThread
}
"""
Represents the posts in a reply thread. Contains 3 sections:
- focused post is the post in the request.
- ancestors are the posts which has the parent ids of each reply layer, finishing with the original post.
- siblings are the posts which share the same parent id, and are older than, the queried post.

Note: Each list is ordered by creation date ascendingly.
"""
type ReplyThread {
    ancestors: [Post]!
    siblings: [Post!]!
    focusedPost: Post!
}

extend type Mutation {
    """
    Create a post.

    Authentication: Required. The authenticated user is the author.
    """
    createPost(input: CreatePostInput!): PostResponse!
    """
    Create a reply.

    Authentication: Required. The authenticated user is the author.
    """
    createReply(input: CreateReplyInput!): PostResponse!
    """
    Create a repost; a repost has a messageContent of null with the a shared post pointing to the original post.

    A user cannot have more than one active repost at one time.

    Authentication: Required. The authenticated user is the author.
    """
    createRepost(sharedPostId: ID!): PostResponse!
    """
    Create a quote; a quotes has a messageContent with the a shared post pointing to the original post.

    Authentication: Required. The authenticated user is the author.
    """
    createQuote(input: CreateQuoteInput!): PostResponse!
    """
    Update post content.

    Applies to posts, comments, and quotes.

    Authentication: Required (user can update their own posts)
    """
    updatePostContent(input: UpdatePostInput!): PostResponse!
    """
    Delete the post.

    Soft delete - sets the post status to DELETED.

    Applies to all post types.

    Authentication: Required (the authenticated user can delete their own posts)
    """
    deletePost(postId: ID!, postType: PostType!): DeleteResponse!
    """
    Add a like to the post.

    Authentication: Required
    """
    likePost(postId: ID!): PostResponse!
    """
    Removes a like from the post.

    Authentication: Required
    """
    unlikePost(postId: ID!): PostResponse!
}

enum PostType {
    POST
    QUOTE
    REPOST
    REPLY
}

"""
Information required to create a post.
"""
input CreatePostInput {
    messageContent: String!
    mentionedUserIds: [ID!]
}

"""
Information required to update a post.
"""
input UpdatePostInput {
    postId: ID!
    messageContent: String!
    mentionedUserIds: [ID!]
}

"""
Information required to create a reply.
"""
input CreateReplyInput {
    parentId: ID!
    messageContent: String!
    mentionedUserIds: [ID!]
}

"""
Information required to create a quote.
"""
input CreateQuoteInput {
    sharedPostId: ID!
    messageContent: String!
    mentionedUserIds: [ID!]
}

"""
Result of a mutating operation on a post.
"""
type PostResponse implements MutationResponse {
    code: String!
    success: Boolean!
    post: Post
    errors: [Error!]
}

# Subscription for:
# C/U/D post
# Likes/unlikes
# C/U/D Comment
# C/U/D Repost

extend type Subscription {
    postEngagement(postId: ID!): EngagementEvent!
    # Real-time feed updates for the authenticated user
    # Emits when someone you follow creates a post
    # Backed by Redis Pub/Sub feed queue
    newPostInFeed: Post!
}

